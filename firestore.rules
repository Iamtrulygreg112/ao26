rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validMember(id) {
      return id in ['alex','sebastian','adrian','ishaan','husam','garrett','will','aja','landon','matheus','martin','kaden','kyle','hayden','declan','tucker','micah','wyatt','jett','aden','james','tristan','xander','emilio','kyan','berk','gabe','luca','chase'];
    }
    match /events/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.headcount is int && request.resource.data.headcount >= 1
        && request.resource.data.weight in [1, 2, 3];
      allow delete: if true;
    }
    match /assignments/{id} {
      allow read, delete: if true;
      allow create, update: if validMember(request.resource.data.memberId)
        && request.resource.data.status in ['assigned', 'vetoed']
        && request.resource.data.source in ['manual', 'suggested', 'cover']
        && id == request.resource.data.eventId + '_' + request.resource.data.memberId;
    }
    match /work_entries/{id} {
      allow read, delete: if true;
      allow create, update: if validMember(request.resource.data.memberId)
        && (request.resource.data.position == null || request.resource.data.position in ['Door', 'Roam', 'Bar', 'Fire Alarm'])
        && id == request.resource.data.eventId + '_' + request.resource.data.memberId;
    }
    match /pins/{memberId} {
      allow get: if validMember(memberId);
      allow list: if false;
      allow create: if validMember(memberId) && request.resource.data.hash is string && request.resource.data.salt is string;
      allow update, delete: if false;
    }
    // ---- Admin (Signal bot) ---------------------------------------------------
    // The Pi bot writes signal_* with a service account, which bypasses these
    // rules; `write: if false` there is intentional. Every pledge may read the
    // mirror; only the admin's Google account (Firebase Auth) touches the queue.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'chasescron@gmail.com';
    }
    match /signal_groups/{id}   { allow read: if true; allow write: if false; }
    match /signal_messages/{id} { allow read: if true; allow write: if false; }
    match /signal_meta/{id}     { allow read: if true; allow write: if false; }
    match /scheduled_sends/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == 'chase'
        && request.resource.data.groupId is string
        && request.resource.data.sendAt is string
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.photoCount is int && request.resource.data.photoCount <= 6;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled';
      match /photos/{n} { allow read, write: if isAdmin(); }
    }
    // ---- Signal linking -------------------------------------------------------
    // The site only CREATES a request (status "pending"); the Pi bot owns every
    // transition after that with its service account. linked_accounts is bot-only.
    match /link_requests/{id} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.memberId is string
        && request.resource.data.requestedBy is string
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }
    match /linked_accounts/{id} { allow read: if true; allow write: if false; }
  }
}
